# Environment Variables Example for Google Maps Scraper (GRU-86)
# DO NOT include real passwords or credentials in this file or commit real secrets to Git.

# Primary Secret File Path (Server-side secret file mount)
PROSPECT_DATABASE_URL_FILE=/run/secrets/prospect_database_url

# Fallback Direct DSN (Optional for container/testing environments)
# PROSPECT_DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# App Server Port Configuration
PORT=8086
